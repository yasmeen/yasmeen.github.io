{
  "name": "yasmeenroumie.com",
  "version": "1.0.0",
  "description": "Source for yasmeenroumie.com",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "build:three": "esbuild mini-yaz/tools/three-entry.js --bundle --format=esm --minify --outfile=assets/mini-yaz/three.min.js",
    "build:model": "node mini-yaz/tools/pack-model.mjs",
    "serve": "http-server . -p 8130 -c-1 -e html",
    "render:art": "node mini-yaz/tools/render.mjs mini-yaz/tools/art.json",
    "render:og": "node mini-yaz/tools/og.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasmeen/yasmeen.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/yasmeen/yasmeen.github.io/issues"
  },
  "homepage": "https://github.com/yasmeen/yasmeen.github.io#readme",
  "devDependencies": {
    "esbuild": "^0.25.12",
    "http-server": "^14.1.1",
    "playwright": "^1.56.1",
    "three": "0.169.0"
  },
  "private": true
}
